{
  "name": "@bangumi-analyzer/server",
  "version": "1.5.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "sync:cli": "tsx scripts/real-sync.ts",
    "inspect": "tsx scripts/inspect-db.ts",
    "tags:audit": "node scripts/tag-audit.mjs",
    "nsfw:audit": "node scripts/nsfw-audit.mjs",
    "franchise:rescan": "tsx scripts/franchise-rescan.ts"
  },
  "dependencies": {
    "@bangumi-analyzer/shared": "workspace:*",
    "@fastify/static": "^8.2.0",
    "fastify": "^5.6.1",
    "undici": "8.12.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "tsx": "^4.20.6"
  }
}
